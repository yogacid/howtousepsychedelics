---
// OPTION A — first-visit acknowledgement modal.
//
// Blocking by design: no backdrop-click or Escape exit, because the reader
// has to acknowledge. Kept deliberately short — a gate is the highest-friction
// moment on the site and the reader has received nothing yet.
//
// The email ask is collapsed behind a link so it does not compete with the
// acknowledgement or turn the card into a wall on mobile.
//
// Not rendered on /crisis/ and other pages where an interruption would be
// actively harmful — see GATE_EXEMPT in Base.astro.
---

<div id="betaNotice" class="beta-notice" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="betaNoticeTitle">
  <div class="beta-notice-backdrop"></div>
  <div class="beta-notice-card">

    <div class="beta-notice-brand">
      <img class="logo-dark" src="/footer-logo-dark.png" alt="Psygaia" width="800" height="200" />
      <img class="logo-light" src="/footer-logo-light.png" alt="Psygaia" width="800" height="200" />
    </div>

    <h2 class="beta-notice-title" id="betaNoticeTitle">This site is still being built.</h2>
    <p class="beta-notice-body">Pages are still being written, and there will be mistakes. Check anything that matters against another source.</p>

    <button type="button" class="beta-notice-btn" id="betaNoticeAccept">I understand</button>

    <button type="button" class="beta-notice-toggle" id="betaNoticeToggle" aria-expanded="false" aria-controls="betaNoticeForm">Notify me when it&rsquo;s finished</button>

    <div id="betaNoticeForm" class="beta-notice-form" hidden>
      <div class="beta-notice-row">
        <input type="email" id="betaNoticeEmail" class="beta-notice-input" placeholder="Your email" autocomplete="email" />
        <button type="button" class="beta-notice-sub" id="betaNoticeSubBtn"><span id="betaNoticeSubText">Sign up</span></button>
      </div>
      <input type="text" id="betaNoticeHp" class="beta-notice-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <p id="betaNoticeError" class="beta-notice-error" style="display:none;"></p>
      <p class="beta-notice-disclaimer">Joins the Psygaia mailing list. Unsubscribe anytime.</p>
    </div>
    <p id="betaNoticeThanks" class="beta-notice-thanks" hidden>Thanks. Check your inbox.</p>

  </div>
</div>

<style is:global>
  /* Global, matching EmailModal/EmailPopup/Feedback. Scoped styles would let
     Astro rewrite [data-theme="light"] into [data-astro-cid-…][data-theme="light"],
     which targets the component instead of <html> and silently kills light mode. */
  .beta-notice {
    position: fixed;
    inset: 0;
    /* Top of the stack — see the z-index scale in global.css. */
    z-index: 4000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s ease;
  }
  .beta-notice.open { opacity: 1; pointer-events: auto; }

  .beta-notice-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.72);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }
  [data-theme="light"] .beta-notice-backdrop { background: rgba(0,0,0,0.45); }

  .beta-notice-card {
    position: relative;
    width: 460px;
    max-width: 100%;
    max-height: calc(100vh - 40px);
    overflow-y: auto;
    padding: 34px 34px 28px;
    border-radius: 16px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    box-shadow: 0 16px 48px rgba(0,0,0,0.45);
    transform: translateY(12px);
    transition: transform 0.28s ease;
  }
  .beta-notice.open .beta-notice-card { transform: translateY(0); }
  [data-theme="light"] .beta-notice-card {
    background: #ffffff;
    box-shadow: 0 20px 60px rgba(0,0,0,0.18);
  }

  .beta-notice-brand { margin-bottom: 28px; }
  .beta-notice-brand img { height: 32px; width: auto; display: block; }
  .beta-notice-brand .logo-dark { display: block; }
  .beta-notice-brand .logo-light { display: none; }
  [data-theme="light"] .beta-notice-brand .logo-dark { display: none; }
  [data-theme="light"] .beta-notice-brand .logo-light { display: block; }

  .beta-notice-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.25rem, 3.2vw, 1.5rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--text-primary);
    margin: 0 0 12px;
  }
  .beta-notice-body {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0 0 22px;
  }

  /* Brand primary CTA: green → blue, matching the eye logo, with the
     shimmer hover the site's other primary buttons use. */
  .beta-notice-btn {
    display: block;
    width: 100%;
    padding: 13px 24px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    border: none;
    border-radius: 100px;
    cursor: pointer;
    color: #040a05;
    background: linear-gradient(135deg, #5cb84a 0%, #2e9fd8 50%, #5cb84a 100%);
    background-size: 300% 100%;
    background-position: 0% center;
    transition: box-shadow 0.25s ease;
  }
  .beta-notice-btn:hover {
    animation: accentShimmer 4s ease-in-out infinite;
    box-shadow: 0 6px 20px rgba(64,217,204,0.18);
  }
  .beta-notice-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .beta-notice-toggle {
    display: block;
    width: 100%;
    margin-top: 14px;
    padding: 4px 0;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-muted);
    background: none;
    border: none;
    cursor: pointer;
    text-align: center;
    transition: color 0.2s ease;
  }
  .beta-notice-toggle:hover { color: var(--accent); }
  .beta-notice-toggle[aria-expanded="true"] { color: var(--accent); }

  .beta-notice-form { margin-top: 14px; }
  .beta-notice-row { display: flex; gap: 8px; }
  .beta-notice-input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 11px 14px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    color: var(--text-primary);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    outline: none;
    transition: border-color 0.2s;
  }
  .beta-notice-input::placeholder { color: var(--text-muted); opacity: 0.8; }
  .beta-notice-input:focus { border-color: var(--accent); }

  .beta-notice-sub {
    flex: 0 0 auto;
    padding: 11px 18px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-primary);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 10px;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .beta-notice-sub:hover { border-color: var(--accent); color: var(--accent); }
  .beta-notice-sub:disabled { opacity: 0.55; cursor: default; }

  .beta-notice-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .beta-notice-error {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    color: #e5794b;
    margin: 8px 0 0;
  }
  .beta-notice-disclaimer,
  .beta-notice-thanks {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.72rem;
    color: var(--text-muted);
    margin: 10px 0 0;
  }
  .beta-notice-thanks { color: var(--accent); font-size: 0.82rem; text-align: center; }

  @media (max-width: 460px) {
    .beta-notice-card { padding: 28px 22px 22px; }
    .beta-notice-row { flex-direction: column; }
    .beta-notice-sub { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .beta-notice, .beta-notice-card { transition: none; }
    .beta-notice-btn:hover { animation: none; }
  }
</style>

<script is:inline>
(function () {
  if (window.__htupBetaNotice) return;
  window.__htupBetaNotice = true;

  var KEY = 'htup_beta_ack';
  var el = document.getElementById('betaNotice');
  if (!el) return;

  var stored;
  try { stored = localStorage.getItem(KEY); } catch (e) { stored = null; }
  if (stored) return;

  var card = el.querySelector('.beta-notice-card');
  var accept = document.getElementById('betaNoticeAccept');
  var toggle = document.getElementById('betaNoticeToggle');
  var formWrap = document.getElementById('betaNoticeForm');
  var emailEl = document.getElementById('betaNoticeEmail');
  var subBtn = document.getElementById('betaNoticeSubBtn');
  var subText = document.getElementById('betaNoticeSubText');
  var errorEl = document.getElementById('betaNoticeError');
  var thanks = document.getElementById('betaNoticeThanks');
  var hp = document.getElementById('betaNoticeHp');

  var lastFocus = document.activeElement;

  function open() {
    el.classList.add('open');
    el.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';
    setTimeout(function () { accept.focus(); }, 60);
    document.addEventListener('keydown', trap, true);
  }

  function close() {
    try { localStorage.setItem(KEY, '1'); } catch (e) {}
    el.classList.remove('open');
    el.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
    document.removeEventListener('keydown', trap, true);
    if (lastFocus && lastFocus.focus) lastFocus.focus();
  }

  // Focus stays inside. Escape is deliberately inert — acknowledgement is
  // the only way out, so there is no keyboard escape hatch.
  function trap(e) {
    if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); return; }
    if (e.key !== 'Tab') return;
    var f = card.querySelectorAll('button, input, a[href]');
    var list = [];
    for (var i = 0; i < f.length; i++) if (f[i].offsetParent !== null) list.push(f[i]);
    if (!list.length) return;
    var first = list[0], last = list[list.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  }

  accept.addEventListener('click', close);

  toggle.addEventListener('click', function () {
    var openNow = formWrap.hasAttribute('hidden');
    if (openNow) {
      formWrap.removeAttribute('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      emailEl.focus();
    } else {
      formWrap.setAttribute('hidden', '');
      toggle.setAttribute('aria-expanded', 'false');
    }
  });

  subBtn.addEventListener('click', function () {
    var email = (emailEl.value || '').trim();
    errorEl.style.display = 'none';
    if (!email || email.indexOf('@') < 0) {
      errorEl.textContent = 'Enter a valid email, or just continue without one.';
      errorEl.style.display = 'block';
      emailEl.focus();
      return;
    }
    subBtn.disabled = true;
    subText.textContent = 'Sending…';
    fetch('/.netlify/functions/subscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email, first_name: '', _hp: hp.value, source: 'beta-notice' })
    })
      .then(function (r) { return r.ok ? r.json().catch(function () { return {}; }) : Promise.reject(r); })
      .then(function () {
        formWrap.setAttribute('hidden', '');
        toggle.setAttribute('hidden', '');
        thanks.removeAttribute('hidden');
      })
      .catch(function () {
        subBtn.disabled = false;
        subText.textContent = 'Sign up';
        errorEl.textContent = 'Something went wrong. You can continue without signing up.';
        errorEl.style.display = 'block';
      });
  });

  emailEl.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); subBtn.click(); }
  });

  open();
})();
</script>
